# The Orb: REPL + console over native USB-Serial-JTAG (no external USB-UART).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_UART=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash: DIO @ 40MHz for maximum chip compatibility (QIO hangs on some units).
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# 16MB flash + large partition table (16MiBplus.csv -> 3MB app + 13MB VFS).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16MiBplus.csv"
